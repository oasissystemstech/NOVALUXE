# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Optional - app falls back seamlessly if not set)
# VITE_SUPABASE_URL: Found in your Supabase project settings -> API -> Project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: Found in your Supabase project settings -> API -> Project API keys (anon public)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side only Supabase Service Role Key (REQUIRED for Vercel API checkout, lookup, signing, and admin persistence; NEVER expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ADMINISTRATIVE PORTAL AUTHENTICATION (Server-side only - never exposed to browser)
# Required on Vercel / server for HMAC login & verification:
ADMIN_USERNAME="sennelgroup"
ADMIN_EMAIL="sennelgroup@gmail.com"
ADMIN_PASSWORD="your-strong-admin-password-here"
# ADMIN_ROLE: Required exact value ('admin' or 'super_admin'; no default fallback)
ADMIN_ROLE="super_admin"
# ADMIN_SESSION_SECRET: Required high-entropy secret (>= 32 random characters); rotate before production deploy
ADMIN_SESSION_SECRET="replace-with-openssl-rand-hex-32-character-secret"

# CORS ALLOWLIST
# ALLOWED_ORIGINS: Comma-separated explicit production origins
ALLOWED_ORIGINS="https://novaluxebysennel.com,https://www.novaluxebysennel.com"
# PREVIEW_ALLOWED_ORIGINS: Optional comma-separated preview origins used ONLY when VERCEL_ENV=preview
PREVIEW_ALLOWED_ORIGINS=""

# MEDIA URL ALLOWLIST
# TRUSTED_MEDIA_HOSTS: Optional comma-separated HTTPS hostnames allowed alongside project Supabase Storage & local /images/ assets
TRUSTED_MEDIA_HOSTS=""

